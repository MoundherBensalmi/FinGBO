NODE_ENV=development
HOST=127.0.0.1
PORT=3001

DATABASE_URL=postgres://fingbo:fingbo@localhost:5432/fingbo

# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs everyone out.
JWT_SECRET=

# Web app address(es) allowed to call the API, comma-separated
WEB_ORIGINS=http://localhost:3000

# none | cloudflare | proxy
#   cloudflare: only when the API is reached through Cloudflare Tunnel
#   proxy:      only behind a reverse proxy that sets X-Real-IP (Traefik in Dokploy)
TRUST_PROXY=none

# S3-compatible storage for attachments (RustFS / MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=fingbo
S3_ACCESS_KEY=
S3_SECRET_KEY=
