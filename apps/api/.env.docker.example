# API settings for docker-compose.yml (copy to .env.docker).
# Inside a container "localhost" is the container itself: reach this PC's PostgreSQL
# and RustFS through host.docker.internal.

DATABASE_URL=postgres://fingbo:fingbo@host.docker.internal:5432/fingbo

# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs everyone out.
JWT_SECRET=

# Addresses the web app is opened from, comma-separated, no trailing slash
# ── Public (the server's domain)
WEB_ORIGINS=https://web-caisse.gboneproduct.tech
# ── Local network (*.local addresses, or http://<this PC's IP>:3000). Optional.
WEB_ORIGINS_LOCAL=http://web-caisse.gboneproduct.local

TRUST_PROXY=none

# Only the API talks to RustFS. Containers often can't resolve *.local names:
# use host.docker.internal or the LAN IP.
S3_ENDPOINT=http://host.docker.internal:9000
S3_REGION=us-east-1
S3_BUCKET=fingbo
S3_ACCESS_KEY=
S3_SECRET_KEY=
