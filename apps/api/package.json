{
  "name": "@fingbo/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsdown",
    "start": "node --env-file-if-exists=.env dist/index.mjs",
    "typecheck": "tsc",
    "user:create": "tsx --env-file-if-exists=.env src/scripts/create-user.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@fingbo/shared": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "@node-rs/argon2": "^2.2.2",
    "@trpc/server": "^11.28.0",
    "bowser": "^2.15.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "postgres": "^3.4.9",
    "superjson": "^2.2.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "drizzle-kit": "^0.31.11",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  },
  "exports": {
    "./router": {
      "types": "./src/trpc/router.ts"
    }
  }
}
